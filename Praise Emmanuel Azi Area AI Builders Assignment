# ASSIGNMENT 3: STRING OPERATIONS 
# String Operations

# Given string (with extra spaces to demonstrate strip)
text = "   Windpraise loves playing the trumpet   "

# Uppercase
uppercase_text = text.upper()

# Lowercase
lowercase_text = text.lower()

# Strip (remove leading/trailing whitespace)
stripped_text = text.strip()

# Slicing (get a portion of the string)
# After stripping, let's slice out "Windpraise"
sliced_text = stripped_text[0:10]

# Concatenation (joining strings together)
concatenated_text = stripped_text + " and enjoys music production."

# Print results
print("Original:", repr(text))
print("Uppercase:", uppercase_text)
print("Lowercase:", lowercase_text)
print("Stripped:", stripped_text)
print("Sliced (first 10 chars):", sliced_text)
print("Concatenated:", concatenated_text)


Original: '   Praise Emmanuel Azi loves playing the trumpet   '
Uppercase:    PRAISE EMMANUEL AZI LOVES PLAYING THE TRUMPET   
Lowercase:    praise emmanuel azi loves playing the trumpet   
Stripped: Windpraise loves playing the trumpet
Sliced (first 10 chars): Windpraise
Concatenated: Windpraise loves playing the trumpet and enjoys music production.
